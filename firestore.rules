rules_version = '2';

// ============================================================================
// Nilma Protocolos — regras de segurança do Firestore
//
// Por que este arquivo existe: até agora as regras viviam só no console do
// Firebase. Ninguém tinha cópia, ninguém sabia o que estava valendo, e uma
// alteração acidental no console não deixava rastro. Sem isso versionado, o
// comprador está comprando um cadeado sem saber se ele está trancado.
//
// REGRA DE OURO DESTE ARQUIVO: o navegador não decide nada que importe.
// O app esconde botão de admin pra quem não é admin — mas esconder botão não é
// segurança. Qualquer pessoa logada abre o console do navegador e chama o SDK
// direto. O que vale é o que está aqui.
//
// Publicar:   firebase deploy --only firestore:rules
// Testar:     firebase emulators:start --only firestore
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quem é quem ----------

    function logado() {
      return request.auth != null;
    }

    function meuDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function meusPapeis() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? meuDoc().get('roles', [])
        : [];
    }

    function temPapel(papel) {
      return papel in meusPapeis();
    }

    function ehAdmin() {
      return temPapel('admin');
    }

    // Campos que o dono do documento NÃO pode mexer em si mesmo.
    function naoMexeuEm(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    function so(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------- usuários ----------
    // O ponto mais perigoso do sistema inteiro. O campo `roles` é o que separa
    // quem pode apagar a base de clientes de quem não pode. O app escreve esse
    // campo a partir do navegador em quatro lugares; sem estas regras, qualquer
    // funcionário se promove a admin com uma linha no console:
    //
    //     db.collection('usuarios').doc(auth.currentUser.uid)
    //       .update({ roles: ['admin'] })
    //
    match /usuarios/{uid} {
      // Todo mundo do escritório enxerga a equipe: o app monta o filtro
      // "Pessoa" da rota e mostra quem entregou cada documento. É um app
      // interno de uma empresa só — a lista de colegas não é segredo.
      allow get, list: if logado();

      // Criar o próprio cadastro. NUNCA com papel escolhido pelo navegador:
      // ou entra como 'staff', ou entra com exatamente os papéis que constam
      // num convite válido, não usado e não vencido, cujo código a pessoa
      // apresenta. O convite é a autorização; o navegador não inventa papel.
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.roles is list
        && (
          request.resource.data.roles == ['staff']
          || (
            request.resource.data.get('codigoConvite', '') != ''
            && exists(/databases/$(database)/documents/convites/$(request.resource.data.codigoConvite))
            && conviteValido(request.resource.data.codigoConvite)
            && request.resource.data.roles ==
               get(/databases/$(database)/documents/convites/$(request.resource.data.codigoConvite)).data.roles
          )
        );

      // O dono mexe nas próprias preferências — tema, paleta, nome, foto,
      // token de notificação. Em `roles`, não: nem no próprio, nem no dos
      // outros. Só admin muda papel.
      allow update: if logado() && (
        (request.auth.uid == uid && naoMexeuEm(['roles', 'email', 'criadoEm']))
        || ehAdmin()
      );

      // Apagar acesso é ato de administração, e some com o histórico de quem
      // entregou o quê. Fica com o admin.
      allow delete: if ehAdmin();

      // Anotações pessoais: só o dono vê, ponto. Nem o admin.
      match /notas/{nota} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }

    function conviteValido(codigo) {
      let c = get(/databases/$(database)/documents/convites/$(codigo)).data;
      // expiraEm é Timestamp de verdade (não texto): testado isoladamente
      // nesse projeto que NEM string(request.time) NEM timestamp(string)
      // funcionam — as duas conversões falham sempre, mesmo comparando
      // valores óbvios sem tocar em dado nenhum. Timestamp-contra-Timestamp
      // direto, sem converter nada, é o único jeito que funciona de verdade.
      return c.get('usado', false) == false
        && c.expiraEm > request.time;
    }

    // ---------- convites ----------
    // O código É a senha. Quem tem o link entra.
    //
    // Por isso `get` é liberado (a pessoa convidada ainda não tem login e
    // precisa ler o próprio convite) mas `list` é proibido: sem isso, qualquer
    // um baixa a coleção inteira e fica com todos os códigos em aberto —
    // inclusive os de redefinição de senha, que o serviço de contas aceita
    // como única autorização pra trocar a senha de uma conta existente.
    // Liberar `list` aqui é entregar o escritório.
    match /convites/{codigo} {
      allow get: if true;
      allow list: if ehAdmin();
      // Dois formatos de convite: "novo" (cria acesso, carrega os papéis que
      // a pessoa vai ter) e "reset" (troca senha de uma conta que já existe,
      // preso a um uidAlvo — não carrega papéis nenhum). Exigir `roles` nos
      // dois faria o botão "Gerar link de nova senha" ser recusado sempre.
      allow create: if ehAdmin()
        && request.resource.data.usado == false
        && request.resource.data.expiraEm is timestamp
        && (
          (request.resource.data.tipo == 'novo' && request.resource.data.roles is list)
          || (request.resource.data.tipo == 'reset' && request.resource.data.uidAlvo is string)
        );
      // Quem aceita o convite só pode carimbá-lo como usado. Não pode mudar
      // os papéis que ele concede, nem reabrir um convite já queimado.
      allow update: if (logado() && so(['usado', 'usadoEm', 'nome']) && request.resource.data.usado == true)
        || ehAdmin();
      allow delete: if ehAdmin();
    }

    // ---------- clientes ----------
    // Cadastrar e apagar cliente é ato de administração (a UI só mostra esses
    // botões pra admin). Corrigir geo/zona/grupoLocal/dados de honorário,
    // não: quem está na rua é quem sabe onde o cliente fica de verdade, qual
    // empresa aglutina com qual, e como aquele cliente paga o honorário —
    // por isso qualquer pessoa logada pode ajustar esses campos, sem abrir a
    // porta pra reescrever CNPJ, telefone ou nome. `entrega` é a marca de
    // "cliente do Entregas", que o app põe sozinho na primeira entrega.
    match /clientes/{id} {
      allow read: if logado();
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() ||
        // 'ocorrencias' é anotação de atendimento (reclamou, elogiou,
        // combinou): quem atende registra, não é mexer no cadastro.
        // 'bancos'/'bancosRecusados': em quais bancos o cliente tem conta. É
        // conferência de quem cobra o extrato, e quem corrige está olhando o
        // documento — o robô aprende sozinho e erra; alguém precisa poder
        // arrumar sem ser admin.
        (logado() && so(['geo', 'zona', 'grupoLocal', 'honorarioForma', 'honorarioDia', 'pontoReferencia', 'email', 'emails', 'entrega', 'ocorrencias', 'bancos', 'bancosRecusados']));
    }

    // ---------- entregas ----------
    // O registro de entrega é o produto. Depois de criado, ele é prova.
    match /entregas/{id} {
      allow read: if logado();

      allow create: if logado()
        && request.resource.data.criadoEm is string
        // 'link' = guia publicada na página do cliente, esperando ele tocar em
        // "Recebi". Quem confirma depois é o PC do robô (Admin SDK).
        && request.resource.data.status in ['pendente', 'confirmada', 'falha', 'link'];

      // Quem registrou pode corrigir; admin corrige qualquer uma. O que
      // ninguém reescreve é a autoria e a data de criação — é isso que faz o
      // registro valer como prova numa discussão com o cliente.
      // Exceção: confirmar (ou registrar como não realizada) uma entrega que
      // ainda está na rota. Quem monta a rota nem sempre é quem entrega, e o
      // app grava em entregadoPor quem de fato entregou — então aqui a
      // autoria PODE mudar, mas só pra própria pessoa que está confirmando.
      allow update: if logado()
        && resource.data.status in ['pendente', 'link']
        && request.resource.data.status in ['confirmada', 'falha']
        && request.resource.data.entregadoPor == request.auth.token.email
        && naoMexeuEm(['criadoEm']);

      // Quem registrou corrige, mas não DESFAZ entrega concluída: se desse pra
      // voltar uma confirmada pra 'pendente', a regra de "tirar a própria parada
      // da rota", logo abaixo, viraria um jeito de apagar prova de entrega.
      allow update: if logado()
        && (resource.data.get('entregadoPor', '') == request.auth.token.email || ehAdmin())
        && naoMexeuEm(['criadoEm', 'entregadoPor'])
        && (ehAdmin()
          || !(resource.data.status in ['confirmada', 'falha'])
          || request.resource.data.status in ['confirmada', 'falha']);

      // Mudar a ordem da rota: quem monta a rota (admin, no PC) quase nunca é
      // quem anda com ela. Qualquer pessoa da equipe reordena parada pendente,
      // desde que não toque em mais nada.
      allow update: if logado()
        && resource.data.status == 'pendente'
        && so(['ordemRota']);

      // Entrega confirmada é prova e só admin apaga. Parada que ainda está na
      // rota não provou nada: quem a colocou pode tirar.
      allow delete: if ehAdmin()
        || (logado()
          && resource.data.status in ['pendente', 'link']
          && resource.data.get('entregadoPor', '') == request.auth.token.email);

      match /anexos/{anexo} {
        allow read: if logado();
        allow create: if logado();
        allow update, delete: if ehAdmin();
        // Tirar a própria parada da rota leva o anexo junto, no mesmo lote
        // (get() ainda enxerga a entrega como estava antes do lote).
        allow delete: if logado()
          && get(/databases/$(database)/documents/entregas/$(id)).data.status in ['pendente', 'link']
          && get(/databases/$(database)/documents/entregas/$(id)).data.get('entregadoPor', '') == request.auth.token.email;
        // A assinatura vai pro comprovante no mesmo lote que confirma a
        // entrega. Se a parada já tinha comprovante (guia em PDF anexada na
        // montagem da rota), isso vira update — e sem esta linha só o admin
        // conseguiria confirmar. No lote, get() ainda vê a entrega pendente.
        allow update: if logado()
          && get(/databases/$(database)/documents/entregas/$(id)).data.status in ['pendente', 'link'];
      }
    }

    // ---------- recados e solicitações ----------
    match /recados/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 500;
      allow update: if ehAdmin();
      allow delete: if logado()
        && (resource.data.get('criadoPor', '') == request.auth.token.email || ehAdmin());
    }

    // Cada pessoa só lê/mexe no que ela mesma criou ou concluiu. Office boy e
    // admin veem tudo, porque precisam da fila inteira pra atender os pedidos
    // de todo mundo. "create" confere que quem está criando é o próprio
    // criadoPor — sem isso, alguém podia gravar uma solicitação em nome de
    // outra pessoa e o "read" acima passaria a mostrar aquele documento pra
    // essa outra pessoa por engano.
    match /solicitacoes/{id} {
      allow read: if logado() &&
        (ehAdmin() || temPapel('office_boy') ||
         resource.data.get('criadoPor', '') == request.auth.token.email ||
         resource.data.get('concluidoPor', '') == request.auth.token.email);
      allow create: if logado() &&
        request.resource.data.criadoPor == request.auth.token.email;
      allow update: if logado() &&
        (ehAdmin() || temPapel('office_boy') || resource.data.get('criadoPor', '') == request.auth.token.email);
      allow delete: if ehAdmin();
    }

    // ---------- assinaturas do cliente (SEM LOGIN) ----------
    // Única porta aberta pra fora. O cliente do escritório escaneia um QR na
    // calçada e assina no próprio celular — ele não tem conta e não vai criar
    // uma. O token aleatório na URL é a credencial.
    //
    // O app já checava a validade no navegador, mas checagem no navegador não
    // vale nada: quem chama o SDK direto ignora a tela. A expiração e o
    // "assina uma vez só" passam a valer aqui.
    match /assinaturas/{token} {
      // Sem `list`: com ele, qualquer pessoa varre a coleção e lê nome de
      // cliente, competência e documentos de todo mundo, sem login.
      allow get: if true;
      allow list: if logado();

      allow create: if logado()
        && request.resource.data.assinado == false
        && request.resource.data.expiraEm is timestamp;

      // O cliente só faz uma coisa: assinar, uma vez, antes de vencer.
      // expiraEm é Timestamp de verdade (não texto ISO): nesse projeto,
      // NEM string(request.time) NEM timestamp(string) funcionam — as
      // duas conversões falham sempre, confirmado testando isoladamente,
      // até com valores fixos sem tocar em dado nenhum. Timestamp direto
      // contra request.time, sem converter nada, é o que de fato funciona.
      allow update: if resource.data.assinado == false
        && resource.data.expiraEm > request.time
        && request.resource.data.assinado == true
        && so(['assinado', 'assinadoEm', 'assinatura', 'recebedor']);

      allow delete: if ehAdmin();
    }

    // ---------- recado do cliente pela página dele ----------
    // "Fale com o escritório": vira solicitação na fila do office boy, feita
    // pelo PC do robô. Só cria quem tem um link que existe, um recado curto
    // por vez; ninguém lê nem lista pelo app do cliente.
    match /pedidosDoPortal/{id} {
      allow create: if request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{20,64}$')
        && exists(/databases/$(database)/documents/portais/$(request.resource.data.token))
        && request.resource.data.keys().hasOnly(['token', 'assunto', 'texto', 'criadoEm'])
        && request.resource.data.assunto in ['segunda-via', 'buscar-documento', 'duvida', 'outro']
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 400
        && request.resource.data.criadoEm is string && request.resource.data.criadoEm.size() <= 40;
      allow read, delete: if ehAdmin();
      allow update: if false;
    }

    // ---------- documento que o escritório pegou emprestado ----------
    // Livro, contrato, CNH que veio pro escritório e tem que voltar. Some
    // quando some de verdade, então quem pegou registra e qualquer um da
    // equipe dá baixa; apagar é só do admin, pra não sumir o rastro.
    match /emprestimos/{id} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.oque is string && request.resource.data.oque.size() <= 200
        && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() <= 200
        && request.resource.data.pegouEm is string
        && request.resource.data.pegouPor is string;
      // dar baixa (ou corrigir a descrição): o que não muda é quem pegou e quando
      allow update: if logado() && naoMexeuEm(['pegouEm', 'pegouPor', 'clienteId']);
      allow delete: if ehAdmin();
    }

    // ---------- documento enviado pelo link do cliente ----------
    // O cliente manda o extrato/comprovante pela página dele, sem login. O
    // arquivo vem inteiro no documento (em base64, até ~700 KB: o banco não
    // aceita documento maior que 1 MB e o plano gratuito não tem Storage). O
    // PC do robô guarda no Drive, marca o mês como recebido e APAGA o envio.
    // Só cria quem tem um link que existe; ninguém lê nem lista pelo app.
    match /enviosDoPortal/{id} {
      allow create: if request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{20,64}$')
        && exists(/databases/$(database)/documents/portais/$(request.resource.data.token))
        && request.resource.data.keys().hasOnly(['token', 'competencia', 'tipo', 'nome', 'mime', 'tamanho', 'dados', 'criadoEm', 'empresa'])
        && request.resource.data.competencia is string && request.resource.data.competencia.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.tipo in ['extrato', 'comprovante', 'aplicacao']
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.mime in ['application/pdf', 'image/jpeg', 'image/png']
        && request.resource.data.dados is string && request.resource.data.dados.size() <= 960000
        && request.resource.data.criadoEm is string && request.resource.data.criadoEm.size() <= 40
        && (!('empresa' in request.resource.data) || (request.resource.data.empresa is string && request.resource.data.empresa.size() <= 200));
      allow read, delete: if ehAdmin();
      allow update: if false;
    }

    // ---------- protocolos emitidos ----------
    // Cada protocolo impresso leva um código e um QR. Quem tem o papel na mão
    // (fiscal, banco, o próprio cliente) confere em cliente.html?protocolo=
    // que aquilo saiu do escritório e não foi alterado. O código é a chave:
    // 12 letras/números aleatórios, sem listagem. Guarda só o que já está
    // impresso, sem assinatura e sem localização. Não se edita: um protocolo
    // corrigido é outro protocolo, com outro código.
    match /protocolos/{codigo} {
      allow get: if codigo.matches('^[A-HJ-NP-Z2-9]{12}$');
      allow list: if false;
      allow create: if logado()
        && codigo.matches('^[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['clienteNome', 'documento', 'competencia', 'entregas', 'total', 'emitidoEm', 'emitidoPor', 'emitidoPorUid'])
        && request.resource.data.emitidoPorUid == request.auth.uid
        && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() <= 200
        && request.resource.data.competencia is string && request.resource.data.competencia.size() <= 7
        && request.resource.data.emitidoEm is string
        && request.resource.data.entregas is list && request.resource.data.entregas.size() <= 200;
      allow update: if false;
      allow delete: if ehAdmin();
    }

    // ---------- auditoria ----------
    // Trilha de quem fez o quê. Só cresce: ninguém edita, ninguém apaga —
    // nem o admin. Uma trilha que o admin consegue limpar não é trilha.
    match /auditoria/{id} {
      allow read: if ehAdmin();
      allow create: if logado()
        && request.resource.data.quando is string
        && request.resource.data.acao is string;
      allow update, delete: if false;
    }

    // ---------- configuração ----------
    // Guarda, entre outras coisas, a URL do serviço de contas (Apps Script),
    // que tem poder de administrador sobre as contas. Leitura fica com quem
    // está logado porque o app precisa da URL; escrita, só admin.
    match /config/{doc} {
      allow read: if logado();
      allow write: if ehAdmin();
    }

    // ---------- honorários: exceção do mês ----------
    // Nem todo cliente tem honorário/boleto TODO mês (alguns são
    // bimestrais, sazonais, ou simplesmente não devem nada naquele mês).
    // Marcar "não se aplica" aqui é reversível e não toca no cadastro do
    // cliente nem finge que uma entrega aconteceu — é só uma anotação de
    // "não conta como pendente este mês". Qualquer pessoa da equipe marca
    // e desmarca; não é ato de administração.
    match /honorarioNaoAplicavel/{id} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.clienteId is string
        && request.resource.data.mesAno is string;
      allow update: if false;
      allow delete: if logado();
    }

    // ---------- rotaLinks: acompanhamento de rota pro cliente (SEM LOGIN) ----------
    // Outra porta aberta pra fora, igual a `assinaturas`: o cliente recebe
    // um link (WhatsApp ou QR) e abre sem conta. O que ele lê aqui é só
    // nome da parada, quem está na frente e se já foi concluída — nunca
    // documento, valor ou data, e essa regra não abre acesso a `entregas`
    // pra ele: a projeção é gravada por quem já está logado, sempre que a
    // fila muda (sincronizarRotaLinks_ no app).
    match /rotaLinks/{token} {
      // Sem `list`: com ele, um estranho varria a coleção e lia nome de
      // cliente de todo mundo que já recebeu um link, sem login.
      allow get: if true;
      allow list: if logado();

      allow create: if logado()
        && request.resource.data.clienteChave is string
        && request.resource.data.expiraEm is string;

      // Só a projeção pode mudar depois de criado (nome do cliente e zona
      // são fixos desde a criação); e só quem está logado grava — o
      // cliente do outro lado do link não escreve nada, só lê.
      allow update: if logado() && so(['paradasAntes', 'concluida', 'estimativaMinutos', 'atualizadoEm']);

      allow delete: if logado();
    }

    // ---------- portal do cliente (SEM LOGIN, link fixo) ----------
    // Terceira porta aberta pra fora. O cliente abre um link que é sempre o
    // mesmo e vê as guias dos últimos meses, o comprovante de cada entrega e
    // os documentos que ainda deve. Ele NÃO ganha acesso a `entregas` nem a
    // `documentosMensal`: lê só esta cópia, gravada por quem está logado (o
    // app, a tela de Pendências) e pelo robô do Gmail.
    //
    // O token de 40 caracteres na URL é a credencial. Sem `list` pra quem
    // não tem login: com ele, um estranho varria a coleção e lia guia e
    // valor de todo cliente. Link vazou: o admin troca, e o documento antigo
    // é apagado junto com as assinaturas.
    match /portais/{token} {
      allow get: if true;
      allow list: if logado();

      allow create: if ehAdmin()
        && request.resource.data.clienteId is string
        && request.resource.data.criadoEm is string;

      // A equipe só regrava a projeção. De quem é o portal não muda nunca.
      allow update: if logado() && so(['clienteNome', 'entregas', 'documentos', 'escritorio']);

      // Quem tem o link (sem login) grava DUAS coisas, e só nesse formato:
      //  - visto: quando abriu, quando copiou o código, quando viu a guia.
      //    É o que responde "eu não recebi a guia".
      //  - avisar: até 5 endereços de notificação do celular dele, pro robô
      //    mandar o lembrete de vencimento.
      // Nada disso dá acesso a mais dado nenhum, e o tamanho é travado pra o
      // campo não virar depósito.
      allow update: if so(['visto'])
        && request.resource.data.visto is map
        && request.resource.data.visto.keys().hasOnly(['primeira', 'ultima', 'vezes', 'copiou', 'guia'])
        && request.resource.data.visto.primeira is string && request.resource.data.visto.primeira.size() <= 30
        && request.resource.data.visto.ultima is string && request.resource.data.visto.ultima.size() <= 30
        && request.resource.data.visto.copiou is string && request.resource.data.visto.copiou.size() <= 30
        && request.resource.data.visto.guia is string && request.resource.data.visto.guia.size() <= 30
        && request.resource.data.visto.vezes is int && request.resource.data.visto.vezes <= 9999;
      //  - recebido: o toque em "Recebi" de uma guia entregue pelo link
      //    (entregaId -> "data|nome"). Não confirma nada sozinho: quem vira a
      //    entrega pra confirmada é o PC do robô, conferindo que ela estava no link.
      // Só dá pra ACRESCENTAR uma confirmação por vez: quem tem o link não
      // apaga nem troca as anteriores, e o campo não vira depósito.
      allow update: if so(['recebido'])
        && request.resource.data.recebido is map
        && request.resource.data.recebido.size() <= 40
        && request.resource.data.recebido.diff(resource.data.get('recebido', {})).addedKeys().size() == 1
        && request.resource.data.recebido.diff(resource.data.get('recebido', {})).removedKeys().size() == 0
        && request.resource.data.recebido.diff(resource.data.get('recebido', {})).changedKeys().size() == 0;
      // "já paguei": marca uma guia por vez. Não é comprovante — é recado, pro
      // escritório não cobrar quem já pagou. Mesma trava do 'recebido': um
      // acrescentado por vez, nenhum tirado nem alterado.
      allow update: if so(['pago'])
        && request.resource.data.pago is map
        && request.resource.data.pago.size() <= 60
        && request.resource.data.pago.diff(resource.data.get('pago', {})).addedKeys().size() == 1
        && request.resource.data.pago.diff(resource.data.get('pago', {})).removedKeys().size() == 0
        && request.resource.data.pago.diff(resource.data.get('pago', {})).changedKeys().size() == 0;

      allow update: if so(['avisar'])
        && request.resource.data.avisar is list
        && request.resource.data.avisar.size() <= 5
        && (request.resource.data.avisar.size() <= 0 || (request.resource.data.avisar[0] is string && request.resource.data.avisar[0].size() <= 400))
        && (request.resource.data.avisar.size() <= 1 || (request.resource.data.avisar[1] is string && request.resource.data.avisar[1].size() <= 400))
        && (request.resource.data.avisar.size() <= 2 || (request.resource.data.avisar[2] is string && request.resource.data.avisar[2].size() <= 400))
        && (request.resource.data.avisar.size() <= 3 || (request.resource.data.avisar[3] is string && request.resource.data.avisar[3].size() <= 400))
        && (request.resource.data.avisar.size() <= 4 || (request.resource.data.avisar[4] is string && request.resource.data.avisar[4].size() <= 400));

      allow delete: if ehAdmin();

      // A assinatura de cada entrega, baixada só quando o cliente pede.
      match /comprovantes/{entregaId} {
        allow get: if true;
        allow list: if logado();
        allow create, update: if logado();
        allow delete: if ehAdmin();
      }
      // A página da guia (tirada do PDF), também só quando o cliente pede.
      match /guias/{entregaId} {
        allow get: if true;
        allow list: if logado();
        allow create, update: if logado();
        allow delete: if ehAdmin();
      }
    }

    // ---------- Importador LCDPR ----------
    // lcdpr.html passou a checar login e cargo (admin/fiscal) sozinho —
    // essa regra só estava desatualizada porque tinha sido publicada direto
    // pela API antes disso existir, e nunca foi sincronizada de volta pro
    // repositório depois que o app ganhou o próprio portão de acesso.
    match /lcdpr/config {
      allow read, write: if logado() && (ehAdmin() || temPapel('fiscal'));
    }

    // ---------- conciliações (Contábil: conciliador.html, cheque-especial.html) ----------
    // Essas duas ferramentas não vieram no mesmo pacote — se este arquivo
    // fosse publicado sem esta seção, a aba Contábil inteira parava de
    // funcionar pra admin e contábil, porque a regra "porta fechada" no
    // final nega tudo que não tem match próprio.
    match /conciliacoes/{id} {
      allow read, create: if temPapel('admin') || temPapel('contabil');
      allow update, delete: if ehAdmin();
    }

    // ---------- solicitações de e-mail (cobrança de documentos) ----------
    // Painel separado de `solicitacoes` (que é fila interna office_boy):
    // aqui cada documento é um pedido de cobrança por e-mail a um cliente
    // (extrato/comprovante/aplicação em falta). Quem monta e processa a
    // fila é admin/contábil — não é tarefa de office_boy nem staff comum.
    match /solicitacoesEmail/{id} {
      allow read, create, update: if ehAdmin() || temPapel('contabil');
      allow delete: if ehAdmin();
    }

    // ---------- controle mensal de documentos por cliente ----------
    // Um documento por cliente+competência (id: "<clienteId>_<AAAA-MM>"),
    // com um booleano por tipo de documento (extrato/comprovante/aplicacao).
    // É a grade que a tela Pendencias-e-envio-automatico-via-Gmail.html
    // mostra — o que ficar desmarcado é o que entra na cobrança por e-mail.
    match /documentosMensal/{id} {
      allow read, create, update: if ehAdmin() || temPapel('contabil');
      allow delete: if ehAdmin();
    }

    // ---------- robô do Gmail (robo/estado) ----------
    // Estado do robô e do vigia do PC: remetentes, assuntos e nomes de arquivo
    // de clientes, por isso não fica em config/ (que qualquer logado lê). Quem
    // grava é o robô pelo Admin SDK, que não passa por estas regras.
    match /robo/{doc} {
      allow read: if ehAdmin() || temPapel('contabil');
      allow write: if false;
    }

    // ---------- reforço de IA da Consulta rápida ----------
    // A Consulta rápida responde sozinha no navegador o que ela conhece. O que
    // ela não entende vai pra cá, e quem responde é o vigia no PC do
    // escritório, pelo SDK de administrador (que não passa por estas regras).
    //
    // CONVERSA É COISA DE UM. Cada um lê e escreve só a sua. Não é sigilo
    // contra o escritório — é que a pergunta que alguém faz ("o Volponi está
    // devendo de novo?") é do jeito de trabalhar de cada um, e conversa que
    // todo mundo lê é conversa que ninguém usa de verdade. Nem o admin lê a
    // dos outros: admin que precisa do dado abre a tela, onde ele está.
    //
    // O NAVEGADOR NÃO ESCREVE RESPOSTA. Ele cria a conversa, manda a pergunta
    // e põe a conversa em 'pendente'. Os campos que o vigia preenche — a
    // resposta do modelo, o custo, quais consultas rodaram — ficam fora do
    // alcance dele. Sem isso, qualquer pessoa logada forjaria uma resposta do
    // atendente no próprio histórico.
    function minhaConversa() {
      return logado() && resource.data.criadoPor == request.auth.token.email;
    }

    match /conversasIA/{id} {
      allow read: if minhaConversa();
      allow create: if logado()
        && request.resource.data.criadoPor == request.auth.token.email
        && request.resource.data.estado in ['ocioso', 'pendente'];
      // Só dá pra empurrar a conversa pra fila e mexer no título. O estado
      // 'gerando', o erro e o carimbo de resposta são do vigia.
      allow update: if minhaConversa()
        && so(['estado', 'titulo', 'atualizadoEm'])
        && request.resource.data.estado in ['ocioso', 'pendente'];
      // Conversa a pessoa pode jogar fora — é dela, e não é prova de nada.
      // Diferente de `entregas` e `auditoria`, que são protocolo.
      allow delete: if minhaConversa();

      match /mensagens/{msg} {
        function conversaEhMinha() {
          return logado() && get(/databases/$(database)/documents/conversasIA/$(id)).data.criadoPor == request.auth.token.email;
        }
        allow read: if conversaEhMinha();
        // 'model' é papel do vigia, não do navegador: quem escreve pelo app só
        // escreve pergunta.
        allow create: if conversaEhMinha() && request.resource.data.papel == 'user';
        allow update: if false;
        allow delete: if conversaEhMinha();
      }
    }

    // ---------- porta fechada ----------
    // Coleção nova que apareça sem regra própria nasce trancada, em vez de
    // nascer aberta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}