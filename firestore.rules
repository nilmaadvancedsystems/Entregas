rules_version = '2';

// ============================================================================
// Nilma Protocolos — regras de segurança do Firestore
//
// Por que este arquivo existe: até agora as regras viviam só no console do
// Firebase. Ninguém tinha cópia, ninguém sabia o que estava valendo, e uma
// alteração acidental no console não deixava rastro. Sem isso versionado, o
// comprador está comprando um cadeado sem saber se ele está trancado.
//
// REGRA DE OURO DESTE ARQUIVO: o navegador não decide nada que importe.
// O app esconde botão de admin pra quem não é admin — mas esconder botão não é
// segurança. Qualquer pessoa logada abre o console do navegador e chama o SDK
// direto. O que vale é o que está aqui.
//
// Publicar:   firebase deploy --only firestore:rules
// Testar:     firebase emulators:start --only firestore
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quem é quem ----------

    function logado() {
      return request.auth != null;
    }

    function meuDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function meusPapeis() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? meuDoc().get('roles', [])
        : [];
    }

    function temPapel(papel) {
      return papel in meusPapeis();
    }

    function ehAdmin() {
      return temPapel('admin');
    }

    // O setor da pessoa (01/10/2026): o departamento escolhido no Cadastro do nads (usuarios.departamento) ou o
    // papel (roles). Decide qual caixa do Gmail do setor ela vê e de qual ela pode mandar.
    function doSetor(setor) {
      return temPapel(setor) || (logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && meuDoc().get('departamento', '') == setor);
    }
    // a caixa do Gmail que a pessoa pode usar: a do robô (Nilma Contabilidade) é do contábil e do fiscal;
    // a de cada setor, só do setor; o admin usa todas
    function usaCaixa(caixa) {
      return ehAdmin()
        || (caixa == 'robo' && (doSetor('contabil') || doSetor('fiscal')))
        || (caixa == 'contabil' && doSetor('contabil'))
        || (caixa == 'fiscal' && doSetor('fiscal'));
    }

    // Da equipe = tem cadastro em `usuarios` com pelo menos um papel.
    // `logado()` sozinho NÃO basta: a chave do app é pública (está no código
    // da página) e qualquer pessoa na internet cria uma conta no Firebase com
    // ela. Com `logado()` guardando os dados, essa conta lia clientes com
    // CPF/CNPJ, entregas e pendências. Revisto em 25/09/2026.
    function membro() {
      return meusPapeis().size() > 0;
    }

    // Campos que o dono do documento NÃO pode mexer em si mesmo.
    function naoMexeuEm(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    function so(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------- usuários ----------
    // O ponto mais perigoso do sistema inteiro. O campo `roles` é o que separa
    // quem pode apagar a base de clientes de quem não pode. O app escreve esse
    // campo a partir do navegador em quatro lugares; sem estas regras, qualquer
    // funcionário se promove a admin com uma linha no console:
    //
    //     db.collection('usuarios').doc(auth.currentUser.uid)
    //       .update({ roles: ['admin'] })
    //
    match /usuarios/{uid} {
      // Todo mundo do escritório enxerga a equipe: o app monta o filtro
      // "Pessoa" da rota e mostra quem entregou cada documento. É um app
      // interno de uma empresa só — a lista de colegas não é segredo.
      allow get, list: if membro();
      // O próprio cadastro a pessoa sempre lê (é por ele que o app sabe se
      // ela é da equipe).
      allow get: if logado() && request.auth.uid == uid;

      // Quem cria cadastro: o ADMIN (tela "Criar acesso"), ou a própria pessoa
      // trazendo um convite válido, não usado e não vencido — e aí com
      // exatamente os papéis do convite. Até 25/09/2026 qualquer conta se
      // cadastrava sozinha como 'staff', o que, somado a qualquer um poder
      // criar conta no Firebase, abria o banco inteiro pra estranhos.
      allow create: if logado()
        && request.resource.data.roles is list
        && (
          ehAdmin()
          || (
            request.auth.uid == uid
            && request.resource.data.get('codigoConvite', '') != ''
            && exists(/databases/$(database)/documents/convites/$(request.resource.data.codigoConvite))
            && conviteValido(request.resource.data.codigoConvite)
            && request.resource.data.roles ==
               get(/databases/$(database)/documents/convites/$(request.resource.data.codigoConvite)).data.roles
          )
        );

      // O dono mexe nas próprias preferências — tema, paleta, nome, foto,
      // token de notificação. Em `roles`, não: nem no próprio, nem no dos
      // outros. Só admin muda papel.
      allow update: if membro() && (
        (request.auth.uid == uid && naoMexeuEm(['roles', 'email', 'criadoEm']))
        || ehAdmin()
      );

      // Apagar acesso é ato de administração, e some com o histórico de quem
      // entregou o quê. Fica com o admin.
      allow delete: if ehAdmin();

      // Anotações pessoais: só o dono vê, ponto. Nem o admin.
      match /notas/{nota} {
        allow read, write: if membro() && request.auth.uid == uid;
      }
    }

    function conviteValido(codigo) {
      let c = get(/databases/$(database)/documents/convites/$(codigo)).data;
      // expiraEm é Timestamp de verdade (não texto): testado isoladamente
      // nesse projeto que NEM string(request.time) NEM timestamp(string)
      // funcionam — as duas conversões falham sempre, mesmo comparando
      // valores óbvios sem tocar em dado nenhum. Timestamp-contra-Timestamp
      // direto, sem converter nada, é o único jeito que funciona de verdade.
      return c.get('usado', false) == false
        && c.expiraEm > request.time;
    }

    // ---------- convites ----------
    // O código É a senha. Quem tem o link entra.
    //
    // Por isso `get` é liberado (a pessoa convidada ainda não tem login e
    // precisa ler o próprio convite) mas `list` é proibido: sem isso, qualquer
    // um baixa a coleção inteira e fica com todos os códigos em aberto —
    // inclusive os de redefinição de senha, que o serviço de contas aceita
    // como única autorização pra trocar a senha de uma conta existente.
    // Liberar `list` aqui é entregar o escritório.
    match /convites/{codigo} {
      allow get: if true;
      allow list: if ehAdmin();
      // Dois formatos de convite: "novo" (cria acesso, carrega os papéis que
      // a pessoa vai ter) e "reset" (troca senha de uma conta que já existe,
      // preso a um uidAlvo — não carrega papéis nenhum). Exigir `roles` nos
      // dois faria o botão "Gerar link de nova senha" ser recusado sempre.
      allow create: if ehAdmin()
        && request.resource.data.usado == false
        && request.resource.data.expiraEm is timestamp
        && (
          (request.resource.data.tipo == 'novo' && request.resource.data.roles is list)
          || (request.resource.data.tipo == 'reset' && request.resource.data.uidAlvo is string)
        );
      // Quem aceita o convite só pode carimbá-lo como usado. Não pode mudar
      // os papéis que ele concede, nem reabrir um convite já queimado.
      allow update: if (membro() && so(['usado', 'usadoEm', 'nome']) && request.resource.data.usado == true)
        || ehAdmin();
      allow delete: if ehAdmin();
    }

    // ---------- clientes ----------
    // Cadastrar e apagar cliente é ato de administração (a UI só mostra esses
    // botões pra admin). Corrigir geo/zona/grupoLocal/dados de honorário,
    // não: quem está na rua é quem sabe onde o cliente fica de verdade, qual
    // empresa aglutina com qual, e como aquele cliente paga o honorário —
    // por isso qualquer pessoa logada pode ajustar esses campos, sem abrir a
    // porta pra reescrever CNPJ, telefone ou nome. `entrega` é a marca de
    // "cliente do Entregas", que o app põe sozinho na primeira entrega.
    match /clientes/{id} {
      allow read: if membro();
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() ||
        // 'ocorrencias' é anotação de atendimento (reclamou, elogiou,
        // combinou): quem atende registra, não é mexer no cadastro.
        // Em quais bancos o cliente tem conta ('bancos'/'bancosRecusados') é
        // cadastro, e cadastro é do admin — igual a nome, CNPJ e honorário.
        (membro() && so(['geo', 'zona', 'grupoLocal', 'honorarioForma', 'honorarioDia', 'pontoReferencia', 'email', 'emails', 'entrega', 'ocorrencias']));
    }

    // ---------- entregas ----------
    // O registro de entrega é o produto. Depois de criado, ele é prova.
    match /entregas/{id} {
      allow read: if membro();

      allow create: if membro()
        && request.resource.data.criadoEm is string
        // 'link' = guia publicada na página do cliente, esperando ele tocar em
        // "Recebi". Quem confirma depois é o PC do robô (Admin SDK).
        && request.resource.data.status in ['pendente', 'confirmada', 'falha', 'link'];

      // Quem registrou pode corrigir; admin corrige qualquer uma. O que
      // ninguém reescreve é a autoria e a data de criação — é isso que faz o
      // registro valer como prova numa discussão com o cliente.
      // Exceção: confirmar (ou registrar como não realizada) uma entrega que
      // ainda está na rota. Quem monta a rota nem sempre é quem entrega, e o
      // app grava em entregadoPor quem de fato entregou — então aqui a
      // autoria PODE mudar, mas só pra própria pessoa que está confirmando.
      allow update: if membro()
        && resource.data.status in ['pendente', 'link']
        && request.resource.data.status in ['confirmada', 'falha']
        && request.resource.data.entregadoPor == request.auth.token.email
        && naoMexeuEm(['criadoEm']);

      // Quem registrou corrige, mas não DESFAZ entrega concluída: se desse pra
      // voltar uma confirmada pra 'pendente', a regra de "tirar a própria parada
      // da rota", logo abaixo, viraria um jeito de apagar prova de entrega.
      allow update: if membro()
        && (resource.data.get('entregadoPor', '') == request.auth.token.email || ehAdmin())
        && naoMexeuEm(['criadoEm', 'entregadoPor'])
        && (ehAdmin()
          || !(resource.data.status in ['confirmada', 'falha'])
          || request.resource.data.status in ['confirmada', 'falha']);

      // Mudar a ordem da rota: quem monta a rota (admin, no PC) quase nunca é
      // quem anda com ela. Qualquer pessoa da equipe reordena parada pendente,
      // desde que não toque em mais nada.
      allow update: if membro()
        && resource.data.status == 'pendente'
        && so(['ordemRota']);

      // Entrega confirmada é prova e só admin apaga. Parada que ainda está na
      // rota não provou nada: quem a colocou pode tirar.
      allow delete: if ehAdmin()
        || (membro()
          && resource.data.status in ['pendente', 'link']
          && resource.data.get('entregadoPor', '') == request.auth.token.email);

      match /anexos/{anexo} {
        allow read: if membro();
        allow create: if membro();
        allow update, delete: if ehAdmin();
        // Tirar a própria parada da rota leva o anexo junto, no mesmo lote
        // (get() ainda enxerga a entrega como estava antes do lote).
        allow delete: if membro()
          && get(/databases/$(database)/documents/entregas/$(id)).data.status in ['pendente', 'link']
          && get(/databases/$(database)/documents/entregas/$(id)).data.get('entregadoPor', '') == request.auth.token.email;
        // A assinatura vai pro comprovante no mesmo lote que confirma a
        // entrega. Se a parada já tinha comprovante (guia em PDF anexada na
        // montagem da rota), isso vira update — e sem esta linha só o admin
        // conseguiria confirmar. No lote, get() ainda vê a entrega pendente.
        allow update: if membro()
          && get(/databases/$(database)/documents/entregas/$(id)).data.status in ['pendente', 'link'];
      }
    }

    // ---------- recados e solicitações ----------
    match /recados/{id} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 500;
      allow update: if ehAdmin();
      allow delete: if membro()
        && (resource.data.get('criadoPor', '') == request.auth.token.email || ehAdmin());
    }

    // Cada pessoa só lê/mexe no que ela mesma criou ou concluiu. Office boy e
    // admin veem tudo, porque precisam da fila inteira pra atender os pedidos
    // de todo mundo. "create" confere que quem está criando é o próprio
    // criadoPor — sem isso, alguém podia gravar uma solicitação em nome de
    // outra pessoa e o "read" acima passaria a mostrar aquele documento pra
    // essa outra pessoa por engano.
    match /solicitacoes/{id} {
      allow read: if membro() &&
        (ehAdmin() || temPapel('office_boy') ||
         resource.data.get('criadoPor', '') == request.auth.token.email ||
         resource.data.get('concluidoPor', '') == request.auth.token.email);
      allow create: if membro() &&
        request.resource.data.criadoPor == request.auth.token.email;
      allow update: if membro() &&
        (ehAdmin() || temPapel('office_boy') || resource.data.get('criadoPor', '') == request.auth.token.email);
      allow delete: if ehAdmin();
    }

    // ---------- lembretes por empresa (entregas.html) ----------
    // "Algo pra falar com o cliente" na próxima entrega: a equipe cria na
    // página do cliente e quem entrega resolve ("Falei"). Resolver só pode
    // mudar o ativo e a assinatura de quem resolveu — texto, empresa e autor
    // ficam como foram escritos.
    match /lembretesCliente/{id} {
      allow read: if membro();
      allow create: if membro()
        && request.resource.data.criadoPor == request.auth.token.email
        && request.resource.data.clienteId is string
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500
        && request.resource.data.ativo == true;
      allow update: if membro()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo', 'resolvidoEm', 'resolvidoPor', 'resolvidoPorNome'])
        && request.resource.data.resolvidoPor == request.auth.token.email;
      allow delete: if ehAdmin() || (membro() && resource.data.criadoPor == request.auth.token.email);
    }

    // ---------- assinaturas do cliente (SEM LOGIN) ----------
    // Única porta aberta pra fora. O cliente do escritório escaneia um QR na
    // calçada e assina no próprio celular — ele não tem conta e não vai criar
    // uma. O token aleatório na URL é a credencial.
    //
    // O app já checava a validade no navegador, mas checagem no navegador não
    // vale nada: quem chama o SDK direto ignora a tela. A expiração e o
    // "assina uma vez só" passam a valer aqui.
    match /assinaturas/{token} {
      // Sem `list`: com ele, qualquer pessoa varre a coleção e lê nome de
      // cliente, competência e documentos de todo mundo, sem login.
      allow get: if true;
      allow list: if membro();

      allow create: if membro()
        && request.resource.data.assinado == false
        && request.resource.data.expiraEm is timestamp;

      // O cliente só faz uma coisa: assinar, uma vez, antes de vencer.
      // expiraEm é Timestamp de verdade (não texto ISO): nesse projeto,
      // NEM string(request.time) NEM timestamp(string) funcionam — as
      // duas conversões falham sempre, confirmado testando isoladamente,
      // até com valores fixos sem tocar em dado nenhum. Timestamp direto
      // contra request.time, sem converter nada, é o que de fato funciona.
      allow update: if resource.data.assinado == false
        && resource.data.expiraEm > request.time
        && request.resource.data.assinado == true
        && so(['assinado', 'assinadoEm', 'assinatura', 'recebedor']);

      allow delete: if ehAdmin();
    }

    // ---------- recado do cliente pela página dele ----------
    // "Fale com o escritório": vira solicitação na fila do office boy, feita
    // pelo PC do robô. Só cria quem tem um link que existe, um recado curto
    // por vez; ninguém lê nem lista pelo app do cliente.
    match /pedidosDoPortal/{id} {
      allow create: if request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{20,64}$')
        && exists(/databases/$(database)/documents/portais/$(request.resource.data.token))
        && request.resource.data.keys().hasOnly(['token', 'assunto', 'texto', 'criadoEm'])
        && request.resource.data.assunto in ['segunda-via', 'buscar-documento', 'duvida', 'outro']
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 400
        && request.resource.data.criadoEm is string && request.resource.data.criadoEm.size() <= 40;
      allow read, delete: if ehAdmin();
      allow update: if false;
    }

    // ---------- documento que o escritório pegou emprestado ----------
    // Livro, contrato, CNH que veio pro escritório e tem que voltar. Some
    // quando some de verdade, então quem pegou registra e qualquer um da
    // equipe dá baixa; apagar é só do admin, pra não sumir o rastro.
    match /emprestimos/{id} {
      allow read: if membro();
      allow create: if membro()
        && request.resource.data.oque is string && request.resource.data.oque.size() <= 200
        && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() <= 200
        && request.resource.data.pegouEm is string
        && request.resource.data.pegouPor is string;
      // dar baixa (ou corrigir a descrição): o que não muda é quem pegou e quando
      allow update: if membro() && naoMexeuEm(['pegouEm', 'pegouPor', 'clienteId']);
      allow delete: if ehAdmin();
    }

    // ---------- documento enviado pelo link do cliente ----------
    // O cliente manda o extrato/comprovante pela página dele, sem login. O
    // arquivo vem inteiro no documento (em base64, até ~700 KB: o banco não
    // aceita documento maior que 1 MB e o plano gratuito não tem Storage). O
    // PC do robô guarda no Drive, marca o mês como recebido e APAGA o envio.
    // Só cria quem tem um link que existe; ninguém lê nem lista pelo app.
    match /enviosDoPortal/{id} {
      allow create: if request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{20,64}$')
        && exists(/databases/$(database)/documents/portais/$(request.resource.data.token))
        && request.resource.data.keys().hasOnly(['token', 'competencia', 'tipo', 'nome', 'mime', 'tamanho', 'dados', 'criadoEm', 'empresa'])
        && request.resource.data.competencia is string && request.resource.data.competencia.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.tipo in ['extrato', 'comprovante', 'aplicacao']
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.mime in ['application/pdf', 'image/jpeg', 'image/png']
        && request.resource.data.dados is string && request.resource.data.dados.size() <= 960000
        && request.resource.data.criadoEm is string && request.resource.data.criadoEm.size() <= 40
        && (!('empresa' in request.resource.data) || (request.resource.data.empresa is string && request.resource.data.empresa.size() <= 200));
      allow read, delete: if ehAdmin();
      allow update: if false;
    }

    // ---------- protocolos emitidos ----------
    // Cada protocolo impresso leva um código e um QR. Quem tem o papel na mão
    // (fiscal, banco, o próprio cliente) confere em cliente.html?protocolo=
    // que aquilo saiu do escritório e não foi alterado. O código é a chave:
    // 12 letras/números aleatórios, sem listagem. Guarda só o que já está
    // impresso, sem assinatura e sem localização. Não se edita: um protocolo
    // corrigido é outro protocolo, com outro código.
    match /protocolos/{codigo} {
      allow get: if codigo.matches('^[A-HJ-NP-Z2-9]{12}$');
      allow list: if false;
      allow create: if membro()
        && codigo.matches('^[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['clienteNome', 'documento', 'competencia', 'entregas', 'total', 'emitidoEm', 'emitidoPor', 'emitidoPorUid'])
        && request.resource.data.emitidoPorUid == request.auth.uid
        && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() <= 200
        && request.resource.data.competencia is string && request.resource.data.competencia.size() <= 7
        && request.resource.data.emitidoEm is string
        && request.resource.data.entregas is list && request.resource.data.entregas.size() <= 200;
      allow update: if false;
      allow delete: if ehAdmin();
    }

    // ---------- auditoria ----------
    // Trilha de quem fez o quê. Só cresce: ninguém edita, ninguém apaga —
    // nem o admin. Uma trilha que o admin consegue limpar não é trilha.
    match /auditoria/{id} {
      allow read: if ehAdmin();
      allow create: if membro()
        && request.resource.data.quando is string
        && request.resource.data.acao is string;
      allow update, delete: if false;
    }

    // ---------- configuração ----------
    // Guarda, entre outras coisas, a URL do serviço de contas (Apps Script),
    // que tem poder de administrador sobre as contas. Leitura fica com quem
    // está logado porque o app precisa da URL; escrita, só admin.
    match /config/{doc} {
      allow read: if membro();
      allow write: if ehAdmin();
    }

    // ---------- honorários: exceção do mês ----------
    // Nem todo cliente tem honorário/boleto TODO mês (alguns são
    // bimestrais, sazonais, ou simplesmente não devem nada naquele mês).
    // Marcar "não se aplica" aqui é reversível e não toca no cadastro do
    // cliente nem finge que uma entrega aconteceu — é só uma anotação de
    // "não conta como pendente este mês". Qualquer pessoa da equipe marca
    // e desmarca; não é ato de administração.
    match /honorarioNaoAplicavel/{id} {
      allow read: if membro();
      allow create: if membro()
        && request.resource.data.clienteId is string
        && request.resource.data.mesAno is string;
      allow update: if false;
      allow delete: if membro();
    }

    // ---------- rotaLinks: acompanhamento de rota pro cliente (SEM LOGIN) ----------
    // Outra porta aberta pra fora, igual a `assinaturas`: o cliente recebe
    // um link (WhatsApp ou QR) e abre sem conta. O que ele lê aqui é só
    // nome da parada, quem está na frente e se já foi concluída — nunca
    // documento, valor ou data, e essa regra não abre acesso a `entregas`
    // pra ele: a projeção é gravada por quem já está logado, sempre que a
    // fila muda (sincronizarRotaLinks_ no app).
    match /rotaLinks/{token} {
      // Sem `list`: com ele, um estranho varria a coleção e lia nome de
      // cliente de todo mundo que já recebeu um link, sem login.
      allow get: if true;
      allow list: if membro();

      allow create: if membro()
        && request.resource.data.clienteChave is string
        && request.resource.data.expiraEm is string;

      // Só a projeção pode mudar depois de criado (nome do cliente e zona
      // são fixos desde a criação); e só quem está logado grava — o
      // cliente do outro lado do link não escreve nada, só lê.
      // Trava contra ping-pong: regravar só a estimativa (sem a fila ter
      // mudado) é recusado, a não ser pra preencher uma estimativa vazia.
      // Em 25/09/2026 dois aparelhos com estimativas diferentes (0 e null)
      // regravaram os mesmos 3 links ~50 vezes por segundo, o dia inteiro.
      allow update: if membro() && so(['paradasAntes', 'concluida', 'estimativaMinutos', 'atualizadoEm'])
        && (request.resource.data.get('concluida', false) != resource.data.get('concluida', false)
          || request.resource.data.get('paradasAntes', []) != resource.data.get('paradasAntes', [])
          || resource.data.get('estimativaMinutos', null) == null);

      allow delete: if membro();
    }

    // ---------- portal do cliente (SEM LOGIN, link fixo) ----------
    // Terceira porta aberta pra fora. O cliente abre um link que é sempre o
    // mesmo e vê as guias dos últimos meses, o comprovante de cada entrega e
    // os documentos que ainda deve. Ele NÃO ganha acesso a `entregas` nem a
    // `documentosMensal`: lê só esta cópia, gravada por quem está logado (o
    // app, a tela de Pendências) e pelo robô do Gmail.
    //
    // O token de 40 caracteres na URL é a credencial. Sem `list` pra quem
    // não tem login: com ele, um estranho varria a coleção e lia guia e
    // valor de todo cliente. Link vazou: o admin troca, e o documento antigo
    // é apagado junto com as assinaturas.
    match /portais/{token} {
      allow get: if true;
      allow list: if membro();

      allow create: if ehAdmin()
        && request.resource.data.clienteId is string
        && request.resource.data.criadoEm is string;

      // A equipe só regrava a projeção. De quem é o portal não muda nunca.
      allow update: if membro() && so(['clienteNome', 'entregas', 'documentos', 'escritorio']);

      // Quem tem o link (sem login) grava DUAS coisas, e só nesse formato:
      //  - visto: quando abriu, quando copiou o código, quando viu a guia.
      //    É o que responde "eu não recebi a guia".
      //  - avisar: até 5 endereços de notificação do celular dele, pro robô
      //    mandar o lembrete de vencimento.
      // Nada disso dá acesso a mais dado nenhum, e o tamanho é travado pra o
      // campo não virar depósito.
      allow update: if so(['visto'])
        && request.resource.data.visto is map
        && request.resource.data.visto.keys().hasOnly(['primeira', 'ultima', 'vezes', 'copiou', 'guia'])
        && request.resource.data.visto.primeira is string && request.resource.data.visto.primeira.size() <= 30
        && request.resource.data.visto.ultima is string && request.resource.data.visto.ultima.size() <= 30
        && request.resource.data.visto.copiou is string && request.resource.data.visto.copiou.size() <= 30
        && request.resource.data.visto.guia is string && request.resource.data.visto.guia.size() <= 30
        && request.resource.data.visto.vezes is int && request.resource.data.visto.vezes <= 9999;
      //  - recebido: o toque em "Recebi" de uma guia entregue pelo link
      //    (entregaId -> "data|nome"). Não confirma nada sozinho: quem vira a
      //    entrega pra confirmada é o PC do robô, conferindo que ela estava no link.
      // Só dá pra ACRESCENTAR uma confirmação por vez: quem tem o link não
      // apaga nem troca as anteriores, e o campo não vira depósito.
      allow update: if so(['recebido'])
        && request.resource.data.recebido is map
        && request.resource.data.recebido.size() <= 40
        && request.resource.data.recebido.diff(resource.data.get('recebido', {})).addedKeys().size() == 1
        && request.resource.data.recebido.diff(resource.data.get('recebido', {})).removedKeys().size() == 0
        && request.resource.data.recebido.diff(resource.data.get('recebido', {})).changedKeys().size() == 0;
      // "já paguei": marca uma guia por vez. Não é comprovante — é recado, pro
      // escritório não cobrar quem já pagou. Mesma trava do 'recebido': um
      // acrescentado por vez, nenhum tirado nem alterado.
      allow update: if so(['pago'])
        && request.resource.data.pago is map
        && request.resource.data.pago.size() <= 60
        && request.resource.data.pago.diff(resource.data.get('pago', {})).addedKeys().size() == 1
        && request.resource.data.pago.diff(resource.data.get('pago', {})).removedKeys().size() == 0
        && request.resource.data.pago.diff(resource.data.get('pago', {})).changedKeys().size() == 0;

      allow update: if so(['avisar'])
        && request.resource.data.avisar is list
        && request.resource.data.avisar.size() <= 5
        && (request.resource.data.avisar.size() <= 0 || (request.resource.data.avisar[0] is string && request.resource.data.avisar[0].size() <= 400))
        && (request.resource.data.avisar.size() <= 1 || (request.resource.data.avisar[1] is string && request.resource.data.avisar[1].size() <= 400))
        && (request.resource.data.avisar.size() <= 2 || (request.resource.data.avisar[2] is string && request.resource.data.avisar[2].size() <= 400))
        && (request.resource.data.avisar.size() <= 3 || (request.resource.data.avisar[3] is string && request.resource.data.avisar[3].size() <= 400))
        && (request.resource.data.avisar.size() <= 4 || (request.resource.data.avisar[4] is string && request.resource.data.avisar[4].size() <= 400));

      allow delete: if ehAdmin();

      // A assinatura de cada entrega, baixada só quando o cliente pede.
      match /comprovantes/{entregaId} {
        allow get: if true;
        allow list: if membro();
        allow create, update: if membro();
        allow delete: if ehAdmin();
      }
      // A página da guia (tirada do PDF), também só quando o cliente pede.
      match /guias/{entregaId} {
        allow get: if true;
        allow list: if membro();
        allow create, update: if membro();
        allow delete: if ehAdmin();
      }
    }

    // ---------- Importador LCDPR ----------
    // lcdpr.html passou a checar login e cargo (admin/fiscal) sozinho —
    // essa regra só estava desatualizada porque tinha sido publicada direto
    // pela API antes disso existir, e nunca foi sincronizada de volta pro
    // repositório depois que o app ganhou o próprio portão de acesso.
    match /lcdpr/config {
      allow read, write: if membro() && (ehAdmin() || temPapel('fiscal'));
    }

    // ---------- conciliações (Contábil: conciliador.html, cheque-especial.html) ----------
    // Essas duas ferramentas não vieram no mesmo pacote — se este arquivo
    // fosse publicado sem esta seção, a aba Contábil inteira parava de
    // funcionar pra admin e contábil, porque a regra "porta fechada" no
    // final nega tudo que não tem match próprio.
    match /conciliacoes/{id} {
      allow read, create: if temPapel('admin') || temPapel('contabil');
      allow update, delete: if ehAdmin();
    }

    // ---------- solicitações de e-mail (cobrança de documentos) ----------
    // Painel separado de `solicitacoes` (que é fila interna office_boy):
    // aqui cada documento é um pedido de cobrança por e-mail a um cliente
    // (extrato/comprovante/aplicação em falta). Antes só admin/contábil; a
    // Nilma pediu em 2026-09-22 que a aba Pendências ficasse aberta pra
    // equipe inteira. Exclusão continua só com admin.
    // Disparo (um texto e um arquivo pra vários clientes, Robô do Gmail ›
    // Disparo): só admin pede, e em nome próprio. Pedido de disparo só o
    // admin altera. O arquivo vem em pedaços em partes/{n}; o vigia apaga
    // depois de enviar.
    match /solicitacoesEmail/{id} {
      allow read: if membro();
      // disparo: só admin; responder e-mail: admin ou contábil (quem vê o texto do e-mail)
      allow create: if membro() &&
        (request.resource.data.get('tipo', '') != 'disparo' ||
         (ehAdmin() && request.resource.data.get('criadoPorUid', '') == request.auth.uid)) &&
        (request.resource.data.get('tipo', '') != 'responder' ||
         (usaCaixa(request.resource.data.get('caixa', 'robo')) && request.resource.data.get('criadoPorUid', '') == request.auth.uid));
      allow update: if membro() &&
        ((!(resource.data.get('tipo', '') in ['disparo', 'responder']) && !(request.resource.data.get('tipo', '') in ['disparo', 'responder'])) || ehAdmin());
      allow delete: if ehAdmin();
      match /partes/{n} {
        allow create: if (ehAdmin() || doSetor('contabil') || doSetor('fiscal')) && n.matches('^([0-9]|1[01])$')
          && request.resource.data.keys().hasOnly(['dados'])
          && request.resource.data.dados is string && request.resource.data.dados.size() <= 900000;
        allow read, delete: if ehAdmin();
      }
    }

    // ---------- tarefas e requisições por empresa (tarefas.html) ----------
    // O "Notion" do escritório: a equipe toda lê, cria e mexe (status,
    // responsável, prazo, checklist, comentários). Quem criou fica gravado e
    // ninguém troca; apagar só quem criou ou o admin.
    match /tarefas/{id} {
      allow read: if membro();
      allow create: if membro()
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 300
        && request.resource.data.tipo in ['tarefa', 'requisicao']
        && request.resource.data.aberta is bool;
      allow update: if membro()
        && request.resource.data.criadoPorUid == resource.data.criadoPorUid
        && request.resource.data.tipo in ['tarefa', 'requisicao']
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 300;
      allow delete: if ehAdmin() || (membro() && resource.data.criadoPorUid == request.auth.uid);
    }

    // ---------- caderno de cada empresa (tarefas.html) ----------
    // O que quem cobre as férias precisa saber: onde parou, as
    // particularidades da empresa, um recado por banco e quem substitui o
    // responsável. É anotação de trabalho da equipe (não é cadastro, que é do
    // admin), então a equipe toda escreve. Sem senha aqui: o app pede pra não.
    match /empresas/{id} {
      allow read: if membro();
      allow create, update: if membro()
        && request.resource.data.keys().hasOnly(['particularidades', 'ondeParou', 'ondeParouPor', 'ondeParouPorUid', 'ondeParouEm',
             'substitutoUid', 'substitutoNome', 'bancosNotas', 'atualizadoEm', 'atualizadoPor'])
        && (!('particularidades' in request.resource.data) || request.resource.data.particularidades.size() <= 20000)
        && (!('ondeParou' in request.resource.data) || request.resource.data.ondeParou.size() <= 20000);
      allow delete: if ehAdmin();
    }

    // ---------- férias e folgas da equipe (tarefas.html) ----------
    // Cada um marca a própria ausência e quem cobre; o admin marca de qualquer
    // um. Quem cobre vê as tarefas da pessoa em "Minhas tarefas".
    match /ausencias/{uid} {
      allow read: if membro();
      allow write: if membro() && (request.auth.uid == uid || ehAdmin());
    }

    // ---------- anexos das tarefas (tarefas.html) ----------
    // O arquivo fica em pedaços de até ~850 mil letras (base64) em
    // anexosTarefas/{id}/partes/{n}; o documento guarda nome, tipo, tamanho e
    // quantos pedaços. Até 5 MB por arquivo (10 pedaços). A equipe toda lê e
    // anexa; tirar, só quem anexou ou o admin. Os pedaços sobem ANTES do
    // documento, por isso cada um leva o uid de quem subiu.
    match /anexosTarefas/{id} {
      allow read: if membro();
      allow create: if membro()
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.tarefaId is string
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 200
        && request.resource.data.tamanho is int && request.resource.data.tamanho <= 5242880
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 10;
      allow update: if false;
      allow delete: if ehAdmin() || (membro() && resource.data.criadoPorUid == request.auth.uid);
      match /partes/{n} {
        allow read: if membro();
        allow create: if membro() && n.matches('^[0-9]$')
          && request.resource.data.keys().hasOnly(['dados', 'uid'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.dados is string && request.resource.data.dados.size() <= 900000;
        allow delete: if ehAdmin() || (membro() && resource.data.uid == request.auth.uid);
      }
    }

    // ---------- arquivos mandados na conversa com a IA ----------
    // Mesmo formato dos anexos de tarefa (pedaços de até 900 KB), mas é
    // conversa particular: só quem mandou lê. Quem entrega o arquivo à IA é
    // o atendente do PC (Admin SDK), que não passa por estas regras.
    // ---------- nads (30/09/2026): o nads inteiro passa a gravar aqui ----------
    // Tarefas do nads (tarefas-nilma.web.app): uma execução por empresa, competência e
    // departamento, com o histórico em eventos (só acrescentado). O nome não é
    // `tarefas` porque essa coleção é do tarefas.html antigo.
    // ---------- proteção do login do nads (30/09/2026) ----------
    // Com config/nads.protecaoLogin ligado, os dados do nads (rotinas, cadastro) só abrem para o admin ou para
    // o login liberado: nadsSessoes/{uid}_{auth_time} (a hora do login, que o token traz). Quem libera é o
    // admin: aprova o pedido (nadsPedidos), recebe o código e passa para a pessoa, que cria a sessão com ele.
    function protecaoNads() {
      return exists(/databases/$(database)/documents/config/nads)
        && get(/databases/$(database)/documents/config/nads).data.get('protecaoLogin', false) == true;
    }
    function loginNads() {
      return request.auth.uid + '_' + string(request.auth.token.auth_time);
    }
    function membroNoNads() {
      return membro() && (ehAdmin() || !protecaoNads()
        || exists(/databases/$(database)/documents/nadsSessoes/$(loginNads())));
    }
    // os feedbacks do nads (07/10/2026): quem está no nads manda o seu (o print vai no próprio documento, até ~900 KB);
    // só o admin lê todos e marca visto/feito
    match /feedbacks/{id} {
      allow read: if ehAdmin() || (membro() && resource.data.uid == request.auth.uid);
      allow create: if membroNoNads()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'novo'
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 4000
        && request.resource.data.imagem is string && request.resource.data.imagem.size() <= 900000
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'texto', 'imagem', 'tela', 'versao', 'criadoEm', 'status']);
      allow update: if ehAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if ehAdmin();
    }
    match /nadsPedidos/{id} {
      allow read: if membro() && (ehAdmin() || resource.data.uid == request.auth.uid);
      allow create: if membro()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.authTime == string(request.auth.token.auth_time)
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'computador', 'authTime', 'status', 'criadoEm']);
      allow update, delete: if ehAdmin();
      // o código de 6 dígitos: só o admin
      match /codigo/{doc} {
        allow read, write: if ehAdmin();
      }
    }
    match /nadsSessoes/{id} {
      allow read: if membro() && (ehAdmin() || id == loginNads());
      allow create: if membro()
        && id == loginNads()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pedidoId is string
        && exists(/databases/$(database)/documents/nadsPedidos/$(request.resource.data.pedidoId))
        && get(/databases/$(database)/documents/nadsPedidos/$(request.resource.data.pedidoId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/nadsPedidos/$(request.resource.data.pedidoId)).data.status == 'aprovado'
        && get(/databases/$(database)/documents/nadsPedidos/$(request.resource.data.pedidoId)).data.authTime == string(request.auth.token.auth_time)
        // o código vence (validoAte, posto na aprovação); revogar passa o pedido para 'revogado' e apaga o código
        && get(/databases/$(database)/documents/nadsPedidos/$(request.resource.data.pedidoId)).data.get('validoAte', null) is timestamp
        && request.time < get(/databases/$(database)/documents/nadsPedidos/$(request.resource.data.pedidoId)).data.validoAte
        && get(/databases/$(database)/documents/nadsPedidos/$(request.resource.data.pedidoId)/codigo/atual).data.codigo == request.resource.data.codigo;
      allow update: if false;
      allow delete: if ehAdmin() || (membro() && id == loginNads());
    }

    // O cofre de senhas gov.br e certificados do nads (07/10/2026): todo o escritório. O que é segredo chega embaralhado
    // no navegador (chave por pessoa); aqui só se confere o formato. Apagar uma empresa do cofre, só o admin.
    match /cofre/{id} {
      allow read: if membroNoNads();
      allow create, update: if membroNoNads() && request.resource.data.dados is string && request.resource.data.iv is string
        && request.resource.data.dados.size() < 900000;
      allow delete: if ehAdmin();
    }
    match /cofreChaves/{id} {
      allow read: if membroNoNads();
      allow create, update, delete: if membroNoNads();
    }
    match /cofreConfig/{id} {
      allow read, write: if membroNoNads();
    }
    match /rotinas/{id} {
      allow read: if membroNoNads();
      allow create, update: if membroNoNads()
        && request.resource.data.competencia is string && request.resource.data.competencia.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.departamento in ['contabil', 'fiscal', 'dp']
        && request.resource.data.etapas is map
        && id.matches('^[a-z0-9-]{1,120}_[0-9]{4}-[0-9]{2}_(contabil|fiscal|dp)$');
      allow delete: if ehAdmin();
      match /eventos/{ev} {
        allow read: if membroNoNads();
        allow create: if membroNoNads()
          && request.resource.data.tipo is string && request.resource.data.etapa is string
          && request.resource.data.por is string && request.resource.data.em is string;
        allow update, delete: if false;
      }
    }

    // Cadastro da empresa do nads (30/09/2026): contas bancárias, contas padrão dos
    // lançamentos e o histórico do que mudou; o plano de contas fica em plano/atual.
    // A Tarefas (Cadastro) edita; o Extrator e o Creditor do Extratudo leem e gravam.
    // id = o nome da empresa em slug (o mesmo das outras coleções do nads).
    match /cadastro/{id} {
      allow read: if membroNoNads();
      allow create, update: if membroNoNads()
        && id.matches('^[a-z0-9-]{1,120}$')
        && request.resource.data.nome is string
        && request.resource.data.historico is list && request.resource.data.historico.size() <= 200
        && (!('bancos' in request.resource.data) || (request.resource.data.bancos is list && request.resource.data.bancos.size() <= 60))
        && (!('contasPadrao' in request.resource.data) || request.resource.data.contasPadrao is map);
      allow delete: if ehAdmin();
      match /plano/{doc} {
        allow read: if membroNoNads();
        allow create, update: if membroNoNads() && doc == 'atual'
          && request.resource.data.contas is list && request.resource.data.contas.size() <= 5000;
        allow delete: if ehAdmin();
      }
    }

    // Balancete do cliente (29/09/2026): só o texto das contas, subido em
    // Clientes e ajustes; o Creditor do Extratudo lê pela ponte do Entregas.
    match /balancetes/{codigo} {
      allow read: if membro();
      allow create, update: if (ehAdmin() || temPapel('contabil'))
        && codigo.matches('^[0-9]{1,10}$')
        && request.resource.data.codigo == codigo
        && request.resource.data.contas is list && request.resource.data.contas.size() <= 5000;
      allow delete: if ehAdmin() || temPapel('contabil');
    }

    // Creditor (creditor.html, 29/09/2026): o que fica salvo de cada empresa,
    // pelo código do ERP — as contas do layout confirmadas (banco, juros,
    // descontos e históricos) e a conta de cada cliente já conciliado.
    match /creditor/{codigo} {
      allow read: if ehAdmin() || temPapel('contabil');
      allow create, update: if (ehAdmin() || temPapel('contabil'))
        && codigo.matches('^[0-9]{1,10}$')
        && request.resource.data.keys().hasOnly(['contas', 'nomes', 'clientes', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.get('contas', {}) is map
        && request.resource.data.get('nomes', {}) is map
        && request.resource.data.get('clientes', {}) is map;
      allow delete: if ehAdmin();
    }

    match /anexosIA/{id} {
      allow read: if membro() && resource.data.criadoPorUid == request.auth.uid;
      allow create: if membro()
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 200
        && request.resource.data.mime is string
        && request.resource.data.tamanho is int && request.resource.data.tamanho <= 5242880
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 10;
      allow update: if false;
      allow delete: if ehAdmin() || (membro() && resource.data.criadoPorUid == request.auth.uid);
      match /partes/{n} {
        allow read: if membro() && resource.data.uid == request.auth.uid;
        allow create: if membro() && n.matches('^[0-9]$')
          && request.resource.data.keys().hasOnly(['dados', 'uid'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.dados is string && request.resource.data.dados.size() <= 900000;
        allow delete: if ehAdmin() || (membro() && resource.data.uid == request.auth.uid);
      }
    }

    // ---------- parcelamentos dos clientes (tarefas.html) ----------
    // Um documento por parcelamento (PGFN, Simples, Receita, Estado,
    // Prefeitura): 1ª parcela (AAAA-MM), quantidade, valor, vencimento e o
    // mapa 'pagas' (AAAA-MM -> quem marcou). A equipe toda cadastra e marca
    // parcela paga; a empresa e quem cadastrou não mudam depois; apagar só
    // quem cadastrou ou o admin. 'aberto' (ativo) é o que a tela escuta.
    match /parcelamentos/{id} {
      allow read: if membro();
      allow create: if membro()
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.clienteId is string && request.resource.data.clienteId.size() > 0
        && request.resource.data.orgao in ['pgfn', 'simples', 'receita', 'estadual', 'municipal', 'outro']
        && request.resource.data.parcelas is int && request.resource.data.parcelas >= 1 && request.resource.data.parcelas <= 600
        && request.resource.data.primeira is string && request.resource.data.primeira.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.aberto is bool
        && request.resource.data.pagas is map;
      allow update: if membro()
        && request.resource.data.criadoPorUid == resource.data.criadoPorUid
        && request.resource.data.clienteId == resource.data.clienteId
        && request.resource.data.orgao in ['pgfn', 'simples', 'receita', 'estadual', 'municipal', 'outro']
        && request.resource.data.parcelas is int && request.resource.data.parcelas >= 1 && request.resource.data.parcelas <= 600
        && request.resource.data.primeira is string && request.resource.data.primeira.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.aberto is bool;
      allow delete: if ehAdmin() || (membro() && resource.data.criadoPorUid == request.auth.uid);
    }

    // ---------- controle mensal de documentos por cliente ----------
    // Um documento por cliente+competência (id: "<clienteId>_<AAAA-MM>"),
    // com um booleano por tipo de documento (extrato/comprovante/aplicacao).
    // É a grade que a tela Pendencias-e-envio-automatico-via-Gmail.html
    // mostra — o que ficar desmarcado é o que entra na cobrança por e-mail.
    // Aberto pra equipe inteira desde 2026-09-22 (era só admin/contábil).
    match /documentosMensal/{id} {
      allow read, create, update: if membro();
      allow delete: if ehAdmin();
    }

    // ---------- robô do Gmail (robo/estado) ----------
    // Estado do robô e do vigia do PC: remetentes, assuntos e nomes de arquivo
    // de clientes, por isso não fica em config/ (que qualquer logado lê). Quem
    // grava é o robô pelo Admin SDK, que não passa por estas regras.
    match /robo/{doc} {
      // robo/estado (a caixa do robô): contábil e fiscal; robo/caixa-<setor>: só o setor (e o admin); o resto como sempre
      allow read: if ehAdmin()
        || (doc == 'estado' && usaCaixa('robo'))
        || (doc == 'caixa-contabil' && usaCaixa('contabil'))
        || (doc == 'caixa-fiscal' && usaCaixa('fiscal'))
        || (temPapel('contabil') && !(doc in ['caixa-fiscal', 'gmailEstado-fiscal']))
        // robo/sieg (o robô do SIEG ligado ou não): o fiscal também lê (06/10/2026)
        || (doc == 'sieg' && temPapel('fiscal'))
        // robo/fgts (o robô do FGTS Digital ligado e de quem é o certificado do escritório): o DP lê (07/10/2026)
        || (doc == 'fgts' && doSetor('dp'));
      allow write: if false;
    }

    // O SIEG no Fiscal do nads (06/10/2026): o robô deste PC (scripts/sieg.js, pelo Admin SDK) conta as notas de cada
    // cliente (siegContagens) e baixa as saídas do mês quando o nads pede (pedidosSieg → siegSaidas). A tela lê; quem
    // pede é o fiscal (ou o admin), só com estes campos; o resto do pedido o robô escreve.
    match /siegContagens/{id} {
      allow read: if ehAdmin() || temPapel('fiscal') || temPapel('contabil');
      allow write: if false;
    }
    // o resumo das notas dos XMLs do mês (o "Baixar XMLs do SIEG", 07/10/2026): só o robô grava
    match /siegNotas/{id} {
      allow read: if ehAdmin() || temPapel('fiscal') || temPapel('contabil');
      allow write: if false;
    }
    match /siegSaidas/{id} {
      allow read: if ehAdmin() || temPapel('fiscal') || temPapel('contabil');
      allow write: if false;
    }
    match /pedidosSieg/{id} {
      allow read: if ehAdmin() || temPapel('fiscal');
      allow create: if (ehAdmin() || temPapel('fiscal'))
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'tipo', 'codigo', 'cnpj', 'competencia', 'criadoEm', 'criadoPor', 'criadoPorUid', 'partes'])
        // o tipo (07/10/2026): sem ele, baixar as saídas; 'contagem' = o "Contar agora"; 'xmlsCliente' (08/10/2026) = os
        // XMLs que o cliente mandou, em pedaços na subcoleção xmls (partes = quantos)
        && (!('tipo' in request.resource.data) || request.resource.data.tipo in ['saidas', 'contagem', 'xmls', 'xmlsCliente']);
      allow update, delete: if false;
      // os pedaços dos XMLs do cliente (o texto, até ~1 MB cada): quem pede escreve antes do pedido; só o robô lê e apaga
      match /xmls/{n} {
        allow create: if (ehAdmin() || temPapel('fiscal'))
          && request.resource.data.keys().hasOnly(['n', 'dados'])
          && request.resource.data.n is int
          && request.resource.data.dados is string && request.resource.data.dados.size() <= 1000000;
        allow read, update, delete: if false;
      }
    }

    // O FGTS Digital no DP do nads (07/10/2026): o robô da máquina do Google (nads/robo/fgts-digital.js, pelo Admin SDK)
    // entra no portal com o certificado do escritório e emite a guia mensal do cliente. Quem pede é o DP (ou o admin),
    // só com estes campos; o andamento, o resultado, o PDF (arquivo/pdf) e as fotos das telas (telas/) o robô escreve.
    match /pedidosFgts/{id} {
      allow read: if ehAdmin() || doSetor('dp');
      allow create: if (ehAdmin() || doSetor('dp'))
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'modo', 'cnpj', 'codigo', 'empresa', 'competencia', 'criadoEm', 'criadoPor', 'criadoPorUid'])
        && request.resource.data.modo in ['ensaio', 'emitir']
        && request.resource.data.cnpj is string && request.resource.data.cnpj.matches('^[0-9]{14}$')
        && request.resource.data.competencia is string && request.resource.data.competencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      allow update, delete: if false;
      match /{parte}/{doc} {
        allow read: if ehAdmin() || doSetor('dp');
        allow write: if false;
      }
      // a verificação do gov.br (08/10/2026): a pessoa do DP clica na tela ao vivo do robô; o robô repete e apaga
      match /cliques/{clique} {
        allow create: if (ehAdmin() || doSetor('dp'))
          && request.resource.data.keys().hasOnly(['x', 'y', 'em', 'por'])
          && request.resource.data.x is number && request.resource.data.y is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1280
          && request.resource.data.y >= 0 && request.resource.data.y <= 900;
      }
    }

    // Escrever para o Claude da rotina pelo nads (07/10/2026): só o admin; o arquivador do PC (Admin SDK) retoma a sessão
    // com a mensagem e escreve o andamento. Quem escreve manda no Claude do PC, com as permissões da rotina: por isso só admin.
    match /arquivadorMensagens/{id} {
      allow read: if ehAdmin();
      allow create: if ehAdmin()
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'texto', 'sessao', 'criadoEm', 'criadoPor', 'criadoPorUid'])
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 4000
        && request.resource.data.sessao is string && request.resource.data.sessao.size() <= 64;
      allow update, delete: if false;
    }

    // ---------- arquivamento (rotina "Claudio Secretario") ----------
    // O Pendências pede ("Arquivar agora") e o arquivador deste PC executa
    // (scripts/arquivador.js). Quem pede só cria o pedido, e só no estado
    // inicial; quem muda status, liga execução e grava resposta é o arquivador,
    // pelo Admin SDK. A única mudança permitida pela tela é cancelar um pedido
    // que ainda não começou.
    match /solicitacoesArquivo/{id} {
      allow read: if ehAdmin() || temPapel('contabil');
      allow create: if (ehAdmin() || temPapel('contabil'))
        && request.resource.data.status == 'pendente'
        && request.resource.data.modo in ['PRODUCAO', 'SIMULACAO']
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'modo', 'criadoEm', 'criadoPor', 'criadoPorUid']);
      allow update: if (ehAdmin() || temPapel('contabil'))
        && resource.data.status in ['pendente', 'aguardando']
        && request.resource.data.status == 'cancelado'
        && so(['status', 'canceladoEm', 'canceladoPor']);
      allow delete: if false;
    }

    // Mapa da pasta do ano no Drive (scripts/drive-indice.js). Só leitura, e
    // só pra quem vê o Arquivo: é a lista de documentos de todos os clientes.
    match /driveIndice/{id} {
      allow read: if ehAdmin() || temPapel('contabil');
      allow write: if false;
      match /partes/{n} {
        allow read: if ehAdmin() || temPapel('contabil');
        allow write: if false;
      }
    }

    // "Atualizar o mapa" pedido pelo nads (Tarefas › Drive; scripts/drive-indice.js). Cada um só lê o seu;
    // pastaId vazio = a pasta do ano inteira. O robô responde no próprio pedido.
    match /pedidosMapaDrive/{id} {
      allow read: if (ehAdmin() || temPapel('contabil')) && resource.data.criadoPorUid == request.auth.uid;
      allow create: if (ehAdmin() || temPapel('contabil'))
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'pastaId', 'criadoEm', 'criadoPor', 'criadoPorUid'])
        && request.resource.data.pastaId is string && request.resource.data.pastaId.size() <= 100;
      allow update, delete: if false;
    }

    // Pedido pra abrir um arquivo do Drive pelo app (scripts/abrir-do-drive.js).
    // Cada um só lê o próprio pedido: a resposta traz o link do arquivo.
    match /aberturasDrive/{id} {
      allow read: if (ehAdmin() || temPapel('contabil')) && resource.data.criadoPorUid == request.auth.uid;
      allow create: if (ehAdmin() || temPapel('contabil'))
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.fileId is string
        && request.resource.data.keys().hasOnly(['status', 'fileId', 'nome', 'criadoEm', 'criadoPor', 'criadoPorUid', 'modo', 'fileIds', 'pastaId', 'nomeZip'])
        // modo: abrir no navegador (padrão), baixar (PDF abre no leitor do
        // computador), zip (vários arquivos, ou uma pasta inteira) ou ler (o
        // Creditor recebe o conteúdo em partes/, pelo banco).
        && request.resource.data.get('modo', 'abrir') in ['abrir', 'baixar', 'zip', 'ler']
        && (!('fileIds' in request.resource.data) || (request.resource.data.fileIds is list && request.resource.data.fileIds.size() <= 500))
        && (!('pastaId' in request.resource.data) || request.resource.data.pastaId is string)
        && (!('nomeZip' in request.resource.data) || (request.resource.data.nomeZip is string && request.resource.data.nomeZip.size() <= 200));
      allow update, delete: if false;
      // o conteúdo do modo 'ler', que o robô grava: só quem pediu lê
      match /partes/{n} {
        allow read: if (ehAdmin() || temPapel('contabil')) && resource.data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    // Arquivo mandado pelo nads (Tarefas › Drive › "Enviar para o Claudio Secretário") para a pasta
    // Claudio Secretario, de onde a rotina de arquivamento tira na próxima rodada (scripts/envios-do-nads.js).
    // Quem manda cria o envio ('enviando'), sobe os pedaços em partes/ e passa para 'pendente'; o robô grava no
    // Drive, apaga os pedaços e responde no próprio envio. Cada um só lê e mexe no seu.
    // ── Mandei (nads, 07/10/2026): os tickets mandados aos clientes ──────────────────────────────────────
    // O ticket inteiro (o controle interno) é só da equipe no nads.
    match /tickets/{id} {
      allow read, create, update: if membroNoNads();
      allow delete: if ehAdmin();
    }
    // O formulário do cliente: um documento por link, pelo código (24 letras e números aleatórios, o segredo do link).
    // Quem tem o código lê só aquele documento (não dá para listar) e, enquanto o link vale (validoAte, a hora do
    // servidor) e o ticket não foi fechado, só marca que abriu e manda as respostas e a lista dos arquivos.
    match /ticketsLinks/{codigo} {
      function vale() {
        return request.time < resource.data.validoAte && resource.data.get('fechado', false) == false;
      }
      allow get: if true;
      allow list: if false;
      allow create, delete: if membroNoNads();
      allow update: if membroNoNads() || (vale()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abertoEm', 'respostas', 'respondidoEm', 'arquivos'])
        && request.resource.data.get('respostas', {}) is map && request.resource.data.get('respostas', {}).size() <= 300
        && request.resource.data.get('arquivos', []) is list && request.resource.data.get('arquivos', []).size() <= 100);
    }

    match /enviosSecretario/{id} {
      function doEnvio() { return (ehAdmin() || temPapel('contabil')) && membroNoNads(); }
      function meu() { return get(/databases/$(database)/documents/enviosSecretario/$(id)).data.criadoPorUid == request.auth.uid; }
      allow read: if doEnvio() && resource.data.criadoPorUid == request.auth.uid;
      allow create: if doEnvio()
        && request.resource.data.status == 'enviando'
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'nome', 'tamanho', 'partes', 'competencia', 'cliente', 'codigo', 'criadoEm', 'criadoPor', 'criadoPorUid'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 200
        && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 26214400
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 30
        && request.resource.data.competencia is string && request.resource.data.competencia.matches('20[0-9]{2}-(0[1-9]|1[0-2])')
        && request.resource.data.cliente is string && request.resource.data.cliente.size() <= 150
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 20;
      // só o "subi tudo": enviando -> pendente
      allow update: if doEnvio() && resource.data.criadoPorUid == request.auth.uid
        && resource.data.status == 'enviando' && request.resource.data.status == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Mandei (07/10/2026): o arquivo que o cliente anexa no formulário (sem login), só com o ticket do link e
      // enquanto ele vale; a equipe no nads acompanha esses envios.
      function linkVale(codigo) {
        return exists(/databases/$(database)/documents/ticketsLinks/$(codigo))
          && request.time < get(/databases/$(database)/documents/ticketsLinks/$(codigo)).data.validoAte
          && get(/databases/$(database)/documents/ticketsLinks/$(codigo)).data.get('fechado', false) == false;
      }
      function ticketDoEnvio() {
        return get(/databases/$(database)/documents/enviosSecretario/$(id)).data.get('ticket', '');
      }
      allow read: if membroNoNads() && resource.data.get('ticket', '') != '';
      allow create: if request.resource.data.get('ticket', '') is string && request.resource.data.get('ticket', '') != ''
        && linkVale(request.resource.data.ticket)
        && request.resource.data.status == 'enviando'
        && request.resource.data.criadoPorUid == 'mandei'
        && request.resource.data.keys().hasOnly(['status', 'nome', 'tamanho', 'partes', 'competencia', 'cliente', 'codigo', 'criadoEm', 'criadoPor', 'criadoPorUid', 'ticket'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 200
        && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 26214400
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 30
        && request.resource.data.competencia is string && request.resource.data.competencia.matches('20[0-9]{2}-(0[1-9]|1[0-2])')
        && request.resource.data.cliente is string && request.resource.data.cliente.size() <= 150
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 20;
      allow update: if resource.data.get('ticket', '') != '' && linkVale(resource.data.ticket)
        && resource.data.status == 'enviando' && request.resource.data.status == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
      match /partes/{n} {
        allow read: if false;
        allow create: if doEnvio() && meu()
          && request.resource.data.keys().hasOnly(['dados'])
          && request.resource.data.dados is bytes && request.resource.data.dados.size() <= 950000;
        // Mandei: os pedaços do arquivo do cliente, enquanto o link do ticket vale
        allow create: if ticketDoEnvio() != '' && linkVale(ticketDoEnvio())
          && request.resource.data.keys().hasOnly(['dados'])
          && request.resource.data.dados is bytes && request.resource.data.dados.size() <= 950000;
        allow update, delete: if false;
      }
    }

    // Texto completo de um e-mail, aberto no painel do Robô do Gmail
    // (scripts/leituras-gmail.js). Cada um lê só o próprio pedido: o texto do
    // e-mail volta dentro dele e o robô apaga em 10 min. Quem grava o texto é
    // o robô (Admin SDK); pela tela só se cria o pedido, nunca se altera.
    match /leiturasGmail/{id} {
      allow read: if (ehAdmin() || doSetor('contabil') || doSetor('fiscal')) && resource.data.criadoPorUid == request.auth.uid;
      allow create: if usaCaixa(request.resource.data.get('caixa', 'robo'))
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.mensagemId is string
        && request.resource.data.mensagemId.matches('^[0-9a-fA-F]{10,32}$')
        && request.resource.data.keys().hasOnly(['status', 'mensagemId', 'criadoEm', 'criadoPor', 'criadoPorUid', 'caixa']);
      allow update, delete: if false;
    }

    // O que foi arquivado: só leitura. Quem escreve é o arquivador, a partir
    // do manifesto da própria rotina.
    match /arquivamentos/{id} {
      allow read: if ehAdmin() || temPapel('contabil');
      allow write: if false;
      match /detalhe/{doc} {
        allow read: if ehAdmin() || temPapel('contabil');
        allow write: if false;
      }
    }

    // ---------- reforço de IA da Consulta rápida ----------
    // A Consulta rápida responde sozinha no navegador o que ela conhece. O que
    // ela não entende vai pra cá, e quem responde é o Claude do PC do
    // escritório (scripts/atendente-claude.js) ou, se escolhido, o Gemini do
    // robô da nuvem — os dois pelo SDK de administrador, que não passa por
    // estas regras.
    //
    // CONVERSA É COISA DE UM. Cada um lê e escreve só a sua. Não é sigilo
    // contra o escritório — é que a pergunta que alguém faz ("o Volponi está
    // devendo de novo?") é do jeito de trabalhar de cada um, e conversa que
    // todo mundo lê é conversa que ninguém usa de verdade. Nem o admin lê a
    // dos outros: admin que precisa do dado abre a tela, onde ele está.
    //
    // O NAVEGADOR NÃO ESCREVE RESPOSTA. Ele cria a conversa, manda a pergunta
    // e põe a conversa em 'pendente'. Os campos que o vigia preenche — a
    // resposta do modelo, o custo, quais consultas rodaram — ficam fora do
    // alcance dele. Sem isso, qualquer pessoa logada forjaria uma resposta do
    // atendente no próprio histórico.
    function minhaConversa() {
      return membro() && resource.data.criadoPor == request.auth.token.email;
    }

    match /conversasIA/{id} {
      allow read: if minhaConversa();
      allow create: if membro()
        && request.resource.data.criadoPor == request.auth.token.email
        && request.resource.data.estado in ['ocioso', 'pendente'];
      // Só dá pra empurrar a conversa pra fila e mexer no título. O estado
      // 'gerando', o erro e o carimbo de resposta são do vigia.
      allow update: if minhaConversa()
        && so(['estado', 'titulo', 'atualizadoEm'])
        && request.resource.data.estado in ['ocioso', 'pendente'];
      // Conversa a pessoa pode jogar fora — é dela, e não é prova de nada.
      // Diferente de `entregas` e `auditoria`, que são protocolo.
      allow delete: if minhaConversa();

      match /mensagens/{msg} {
        function conversaEhMinha() {
          return membro() && get(/databases/$(database)/documents/conversasIA/$(id)).data.criadoPor == request.auth.token.email;
        }
        allow read: if conversaEhMinha();
        // 'model' é papel do vigia, não do navegador: quem escreve pelo app só
        // escreve pergunta.
        allow create: if conversaEhMinha() && request.resource.data.papel == 'user';
        allow update: if false;
        allow delete: if conversaEhMinha();
      }
    }

    // ---------- porta fechada ----------
    // Coleção nova que apareça sem regra própria nasce trancada, em vez de
    // nascer aberta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}