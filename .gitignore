# A base de clientes do escritório (CPF, CNPJ, telefone, endereço, GPS)
# nunca entra neste repositório. Ela é importada uma vez, pelo admin, pelos
# botões Clientes → Base inicial / Endereços e localização — veja INSTALACAO.md.
dados-do-escritorio/
clientes.json
enderecos.json

# arquivos de teste/preview que às vezes ficam soltos na pasta
_preview-*.html

# scripts locais de automação (Claude) - nunca vão pro repositório/hosting
scripts/node_modules/
scripts/*.log
scripts/.firebase-token
scripts/gmail_oauth_client.json
scripts/gmail_token.json
scripts/gmail_token.json.anterior
scripts/gmail-processados.json
scripts/gmail-sem-cliente.json
scripts/vigia.lock
# a chave do Gemini (o reforço de IA da Consulta rápida). Fica só no PC do
# escritório — no repositório ou no Firestore, qualquer um gastaria a cota.
scripts/gemini_key.json
# lista de clientes que o vigia guarda no PC do robô (dado de cliente)
scripts/clientes-cache.json

# freio de reinício do vigia
scripts/vigia-partidas.json
scripts/*.tmp
scripts/avisos-vencimento-feitos.json
scripts/gmail-tentativas.json
